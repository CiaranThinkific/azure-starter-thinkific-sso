# Issuer URL. The function reads /.well-known/openid-configuration from this address.
# Entra: https://login.microsoftonline.com/{tenant-id}/v2.0
# Okta:  https://{your-domain}/oauth2/default
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Public callback registered at the provider.
# https://YOUR-FUNCTION-APP.azurewebsites.net/api/callback
OIDC_REDIRECT_URI=

THINKIFIC_SUBDOMAIN=
THINKIFIC_SSO_SECRET=

# Optional
RETURN_TO_URL=
ERROR_URL=
OIDC_SCOPES=openid profile email
# Set to on to send the OIDC sub claim as Thinkific external_id.
EXTERNAL_ID=

# Optional endpoint overrides. Leave blank to use discovery.
# When authorization, token, and JWKS are all set, discovery is skipped.
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
OIDC_USERINFO_ENDPOINT=
